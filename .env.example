# Copiez ce fichier en .env puis remplissez les valeurs.

# Base PostgreSQL. Supabase : Connect > « Session pooler » (port 5432, PAS 6543), du type
# postgresql://postgres.<id-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Base locale : postgresql://<utilisateur>:<mot-de-passe>@localhost:5432/<base>
DATABASE_URL=postgresql://data:change-me@localhost:5432/flavors

# Contact affiché dans le User-Agent (exigé par Wikimedia et Open Food Facts).
# Mettez une adresse d'équipe, pas une adresse personnelle.
CONTACT=equipe-data@example.org

# Secret utilisé pour pseudonymiser les auteurs (HMAC-SHA256). Obligatoire pour le nettoyage.
# Générez-le une fois : python -c "import secrets; print(secrets.token_hex(32))"
# Ne le changez plus ensuite, sinon un même auteur aura deux identifiants différents.
PSEUDONYMIZATION_SALT=

# YouTube Data API v3 (clé gratuite sur console.cloud.google.com). Vide = source ignorée.
YOUTUBE_API_KEY=
# Unités autorisées par exécution (quota quotidien : 10 000 ; une recherche + ses stats = 101 unités).
# 9 000 = 89 recherches par jour. Si arômes x langues dépasse ce nombre, une rotation quotidienne
# garantit que chaque arôme est couvert au moins un jour sur deux.
YOUTUBE_UNIT_BUDGET=9000

# Bluesky : identifiant complet (ex. monequipe.bsky.social) + mot de passe d'application
# (Paramètres > Confidentialité et sécurité > Mots de passe d'application). Évitez le mot de passe principal.
# Vide = source ignorée.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Open Food Facts : périmètre de collecte. Vide = tous les aliments, monde entier.
# Exemples pour restreindre : OFF_CATEGORIES=en:beverages,en:snacks   OFF_COUNTRIES=en:france,en:belgium
OFF_CATEGORIES=
OFF_COUNTRIES=

# Langues des collectes texte (codes ISO 639-1)
LANGS=fr,en

# --- Maîtrise de l'espace disque (Supabase) ---------------------------------------
# Profil « Supabase gratuit (500 Mo) ». Pour Supabase Pro (8 Go) : WIKIPEDIA_START=2016-01-01,
# RAW_RETENTION_DAYS=14, DB_SIZE_LIMIT_MB=8000, BLUESKY_MAX_PAGES=3, et import-off-dump possible.
# Ne garder que les produits Open Food Facts qui citent un de nos arômes (environ 30 % des produits)
OFF_ONLY_FLAVOR_MATCHES=true
# Début de l'historique Wikipédia au premier passage (2 ans suffisent pour calculer les scores)
WIKIPEDIA_START=2024-01-01
# Supprimer la couche brute N jours après son nettoyage (0 = tout garder). La couche propre reste intacte.
RAW_RETENTION_DAYS=3
# Taille maximale de la base, en Mo : alerte à 80 % et 95 % dans flavortrends freshness (0 = pas de limite)
DB_SIZE_LIMIT_MB=500
# Pages de 100 posts par recherche Bluesky (les mots courants comme « coffee » en renvoient des milliers)
BLUESKY_MAX_PAGES=1

# Pinterest : l'API Trends est réservée aux partenaires (agences, grands comptes).
# Vide = seule la veille manuelle est utilisée (flavortrends import-pinterest).
PINTEREST_ACCESS_TOKEN=
PINTEREST_REGIONS=FR,US
PINTEREST_TREND_TYPES=growing
PINTEREST_INTERESTS=food_and_drinks

# Google Trends automatique (pytrends, non officiel) : zones « ZONE:langue », WORLD = monde entier
GOOGLE_TRENDS_ZONES=WORLD:en,FR:fr
